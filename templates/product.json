      "blocks": {
        "accor_item_nbGUYm": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "Orders",
            "content": "<h3>How do I place an order?</h3><p>Simply add the items you like to your cart, proceed to checkout, fill in your contact and shipping details, choose a payment method, and confirm your purchase.</p><h3>Can I change my order after placing it?</h3><p>If you notice a mistake, please contact our support team <strong>as soon as possible</strong>. We’ll do our best to make changes before the order is shipped.</p>"
          }
        },
        "accor_item_eD3zTe": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "Payment",
            "content": "<h3>What payment methods do you accept?</h3><p>We accept major credit and debit cards (Visa, Mastercard), online banking, and other secure payment methods available at checkout depending on your location.</p><h3>Can I pay upon delivery?</h3><p>Cash on delivery may be available in certain regions. If supported, this option will appear during checkout.</p>"
          }
        },
        "accor_item_BHy9BB": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "Shipping",
            "content": "<h3>How long does shipping take?</h3><p>Delivery usually takes <strong>3–14 business days</strong>, depending on your location and the selected shipping method. Estimated delivery times are shown at checkout.</p><h3>How can I track my order?</h3><p>Once your order has been shipped, you’ll receive a tracking number via email or SMS. You can use it to track your package on the carrier’s website.</p>"
          }
        },
        "accor_item_Qfk43a": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "Returns & Exchanges",
            "content": "<p><strong>How can I return or exchange an item?</strong><br/><br/>You may return or exchange items within the allowed return period (typically up to 14 days after delivery). Items must be <strong>unused and in original condition with tags attached</strong>. Please see our Returns & Exchanges page for full details.</p><p><strong>What if the item doesn’t fit me?</strong><br/><br/>You can request an <strong>exchange for a different size</strong> or return the item according to our return policy.</p>"
          }
        },
        "accor_item_mGhRQ8": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "Sizing & Quality",
            "content": "<h3>How do I choose the right size?</h3><p>Each product page includes a size chart to help you choose the best fit. If you’re unsure, feel free to contact our support team for assistance.</p><h3>Do the items look exactly like the photos?</h3><p>We strive to ensure that all product photos and descriptions are as accurate as possible. However, slight color differences may occur due to screen settings.</p>"
          }
        },
        "accor_item_BwmDKA": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "General",
            "content": "<h3>Do I need to create an account to place an order?</h3><p>No, you can check out as a guest. However, creating an account allows you to track orders, view purchase history, and manage returns more easily.</p><h3>Do you offer discounts or promotions?</h3><p>Yes! Subscribe to our newsletter and follow us on social media to receive updates on <strong>special offers, promotions, and discount codes</strong>.</p>"
          }
        }
